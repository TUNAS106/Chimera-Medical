# To use these environment variables:
# 1. Populate the .env file with your API keys.
# 2. Include the following code snippet in your Python script:
#    from dotenv import load_dotenv
#    import os
#
#    load_dotenv()  # Load environment variables from .env file

#===========================================
# Models API
#===========================================

# Self-hosted Qwen3-VL served by the Kaggle vLLM notebook.
# The URL must be reachable from the machine/container running Chimera.
CHIMERA_FOUNDATION_CORP="vllm"
CHIMERA_FOUNDATION_MODEL="Qwen/Qwen3-VL-30B-A3B-Instruct"
CHIMERA_FOUNDATION_BASE_URL="http://127.0.0.1:8000/v1"
CHIMERA_FOUNDATION_API_KEY="chimera-local-change-me"
CHIMERA_FOUNDATION_TIMEOUT="600"
CHIMERA_FOUNDATION_MAX_RETRIES="0"
CHIMERA_FOUNDATION_TRANSIENT_RETRIES="2"
CHIMERA_FOUNDATION_RETRY_BASE_SECONDS="1"
CHIMERA_FOUNDATION_MAX_TOKENS="8192"
CHIMERA_FOUNDATION_TOP_P="0.9"

# Simulation size. The default medical smoke/full run uses five employees over
# the complete two-week schedule.
CHIMERA_EMPLOYEE_NUMBER="5"
CHIMERA_PERIOD="2"
CHIMERA_CONTAINER_NAME="chimera2"
# Host-only capture settings used by the normal and attack runners. The patched
# modern-BPF build is required on kernel 7.0; both runners also auto-detect this
# path from SUDO_USER when invoked through sudo.
# CHIMERA_SYSDIG_BIN="/home/tunas/.local/bin/sysdig-chimera"
# CHIMERA_SYSDIG_PLUGIN_DIR="/usr/share/sysdig/plugins"
# CHIMERA_CAPTURE_DIR="/data/Logs"
# Set this after profiles are generated when running scripts/attack_auto.sh.
# CHIMERA_ATTACKER_ID="role-1"
# CHIMERA_ATTACK_IDS="multi_attack_2"

# CHIMERA_WEB_MODE controls daily employee web behavior:
# - llm_only: no public web access; model knowledge only.
# - search_only: bounded search/fetch without Chromium (recommended on 16 GiB).
# - browser: full Playwright automation, only for deliberate browser tests.
# CHIMERA_OFFLINE_MODE=true always forces llm_only.
CHIMERA_OFFLINE_MODE="false"
CHIMERA_WEB_MODE="search_only"
CHIMERA_MAX_CONCURRENT_TASKS="3"
CHIMERA_MAX_AUX_MODEL_CALLS="1"
CHIMERA_VLLM_MAX_NUM_SEQS="4"
# Refuse to open captures when the 16 GiB host is already under memory pressure.
CHIMERA_HOST_MIN_AVAILABLE_MB="2048"
CHIMERA_TASK_TIMEOUT_SECONDS="900"
CHIMERA_TASK_TERMINATE_GRACE_SECONDS="10"
CHIMERA_WORKDAY_START="08:00:00"
CHIMERA_WORKDAY_END="18:00:00"
CHIMERA_WEB_SEARCH_CONNECT_TIMEOUT="5"
CHIMERA_WEB_SEARCH_TIMEOUT="15"
CHIMERA_WEB_SEARCH_MAX_ATTEMPTS="4"
CHIMERA_WEB_FETCH_MAX_BYTES="1048576"
CHIMERA_WEB_FETCH_MAX_CHARS="12000"
CHIMERA_WEB_FETCH_MAX_REDIRECTS="3"
CHIMERA_WEB_FETCH_REQUIRE_SEARCH_RESULT="true"
CHIMERA_WEB_FETCH_MAX_FAILURES="2"
CHIMERA_WEB_QUERY_MAX_CHARS="500"
CHIMERA_BROWSER_ROUND_LIMIT="6"
CHIMERA_MAX_TOOL_ARGUMENT_CHARS="4096"
CHIMERA_ACTIVITY_MAX_TOOL_ITERATIONS="8"
CHIMERA_ACTIVITY_SEMANTIC_RETRIES="1"
CHIMERA_TERMINAL_FILE_READ_MAX_CHARS="12000"
# Weekly company planning is internal; keep search disabled to avoid irrelevant
# tool calls and search-provider rate limits. Daily behavior tools are unaffected.
CHIMERA_MEETING_ENABLE_SEARCH="false"

# Includes prompts and responses in model_calls.jsonl. Set false to log only
# metadata, duration, token usage, and error information.
CHIMERA_LOG_MODEL_CONTENT="true"

# Optional: change the original /data/Chimera runtime directory.
# CHIMERA_BASE_DIR="/data/Chimera"
# CHIMERA_SCENARIO_NAME="chimera_scenario_1"

# OpenAI API (https://platform.openai.com/signup)
OPENAI_API_KEY=""

GEMINI_API_KEY="XXX" # Gemini API

DEEPSEEK_API_KEY="XXX" # DeepSeek API (https://www.deepseek.com/)

#===========================================
# Tools & Services API
#===========================================

# Google Search API (https://developers.google.com/custom-search/v1/overview)
GOOGLE_API_KEY="XXX"

SEARCH_ENGINE_ID="XXX"

# Chunkr API (https://chunkr.ai/)
CHUNKR_API_KEY="XXX"

# Meshy API (https://www.meshy.ai/api)
# MESHY_API_KEY="Fill your API key here"

# Dappier API (https://api.dappier.com/)
# DAPPIER_API_KEY="Fill your API key here"

# Discord Bot API (https://discord.com/developers/applications)
# DISCORD_BOT_TOKEN="Fill your API key here"

# OpenBB Platform API (https://my.openbb.co/app/credentials)
# OPENBB_TOKEN="Fill your API key here"

# Bocha Platform API(https://open.bochaai.com)
# BOCHA_API_KEY="Fill your API key here"
